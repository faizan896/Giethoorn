#!/usr/bin/env bash
# A new bounded supervision root for each service start. Never resume or prune.
set -euo pipefail
umask 077
service_binary=
service_state=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --binary) [[ $# -ge 2 ]] || exit 2; service_binary=$2; shift 2 ;;
    --state-dir) [[ $# -ge 2 ]] || exit 2; service_state=$2; shift 2 ;;
    --) shift; break ;;
    --help) echo 'Usage: run-collector-service --binary PATH --state-dir PATH -- [supervise options]'; exit 0 ;;
    *) echo "Unknown service-runner option: $1" >&2; exit 2 ;;
  esac
done
[[ -n "$service_binary" && -f "$service_binary" && -x "$service_binary" ]] || { echo 'An executable collector binary is required' >&2; exit 2; }
[[ -n "$service_state" && "$service_state" = /* ]] || { echo 'An absolute writable state directory is required' >&2; exit 2; }
mkdir -p "$service_state"
service_run=$(mktemp -d "$service_state/run-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
echo "Giethoorn service artifacts: $service_run" >&2
exec "$service_binary" supervise --output-dir "$service_run/supervision" "$@"
